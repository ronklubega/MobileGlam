# Copy to apps/web/.env.local (server) and apps/mobile/.env (EXPO_PUBLIC_* only). Never commit real values.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server only
DATABASE_URL=                     # Postgres connection string (for drizzle/migrations)

# --- MTN MoMo Collection API ---
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_TARGET_ENV=sandbox       # sandbox | mtnuganda
MTN_MOMO_SUBSCRIPTION_KEY=        # Ocp-Apim-Subscription-Key (Collection product)
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_CALLBACK_SECRET=         # random string appended to callback URL path

# --- Airtel Money Open API ---
AIRTEL_BASE_URL=https://openapiuat.airtel.africa
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_COUNTRY=UG
AIRTEL_CURRENCY=UGX
AIRTEL_CALLBACK_SECRET=

# --- SMS (Africa's Talking) ---
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=

# --- Reminders cron auth ---
CRON_SECRET=

# --- App ---
APP_BASE_URL=http://localhost:3000

# --- Local testing without MTN/Airtel credentials (ignored/forbidden in production) ---
# PAYMENTS_MODE=mock   # deposits auto-approve after ~8s; payer numbers ending in 0 are declined

# --- Dashboard ---
# Comma-separated emails allowed to see the platform-wide Refund queue
PLATFORM_ADMIN_EMAILS=support@goldminefinance.com

# --- Supabase Send SMS auth hook (Authentication -> Hooks -> Send SMS -> generate secret) ---
SEND_SMS_HOOK_SECRET=v1,whsec_replace_me
